---
import Base from "../layouts/Base.astro";

const work = [
  {
    when: "2024 — now",
    name: "Remorch, payment gateway",
    note: "The page a customer pays through. Going zoneless meant deleting a component library rather than licensing it onto a payment form.",
    stack: "Angular 22, signals, zoneless, native dialog",
    href: "/work/remorch-pay",
  },
  {
    when: "2024 — now",
    name: "Remorch, admin panel",
    note: "Three Angular majors in one pass, on a panel the desk runs live. The framework was the cheap part; 53 components changing change-detection semantics was not.",
    stack: "Angular 22, ag-grid 36, ECharts, vitest",
    href: "/work/remorch-panel",
  },
  {
    when: "2024 — now",
    name: "Remorch, wallet",
    note: "A swap took the signature and did nothing. The ticket named one defect and the code had three, one of which had been silencing failures across the whole app.",
    stack: "Angular, RxJS, multi-chain signing",
    href: "/work/remorch-app",
  },
  {
    when: "2025 — now",
    name: "Zhambon",
    note: "An investment-pool platform where four roles read the same numbers and may do different things with them. The origin server has no inbound ports.",
    stack: "Angular PWA, Caddy, Docker, Cloudflare Tunnel",
    href: "/work/zhambon",
  },
  {
    when: "demo",
    name: "CAIRN",
    note: "A flask you can turn, cool down and buy. One scroll position drives the camera, the explode, the temperature model and the copy, so nothing on the page can fall out of sync.",
    stack: "three.js, no build step, 39 assertions",
    href: "/work/cairn",
  },
  {
    when: "demo",
    name: "OSSA",
    note: "A small-batch storefront where stock is tracked per variant, not per product — so a sold-out size stays visible and struck through instead of quietly disappearing.",
    stack: "vanilla JS, no framework, no build step",
    href: "/work/ossa",
  },
];
---

<Base
  title="Amir Balazade — front-end engineer"
  description="Front-end engineer, seven years in Angular and TypeScript, most of it in fintech and web3."
  path="/"
>
  <h1 class="lede">I build the screens where a wrong number is noticed in seconds.</h1>

  <p class="standfirst">
    Seven years in Angular and TypeScript, most of it in fintech and web3 — order books, payment
    flows, admin panels dense with tables and charts. Based in Istanbul, working remotely.
  </p>

  <dl class="figures">
    <div>
      <dt>Years in Angular</dt>
      <dd>7+</dd>
    </div>
    <div>
      <dt>Traders on live data</dt>
      <dd>5,000+</dd>
    </div>
    <div>
      <dt>Demos you can open</dt>
      <dd>2</dd>
    </div>
  </dl>

  <section class="work" aria-label="Selected work">
    {
      work.map((item) => {
        const Row = item.href ? "a" : "div";
        return (
          <Row class="work-row" href={item.href}>
            <span class="work-when">{item.when}</span>
            <span>
              <span class="work-name">{item.name}</span>
              <p class="work-note">{item.note}</p>
              <p class="work-stack">{item.stack}</p>
            </span>
          </Row>
        );
      })
    }
  </section>

  <p><a class="action" href="/cv">Read the full CV</a></p>
</Base>
