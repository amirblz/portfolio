---
import Desktop from "../layouts/Desktop.astro";
import Window from "../components/Window.astro";
import { appById, iconSrc } from "../data/apps";

const projects = ["remorch-app", "remorch-panel", "remorch-pay", "wordy", "zhambon", "demos"].map((id) => appById[id]);
---

<Desktop
  title="Amir Balazade, front-end engineer"
  description="Front-end engineer, seven years in Angular and TypeScript, most of it in fintech and web3."
  path="/"
>
  <Window app="welcome" flush>
    <div class="welcome">
      <header class="welcome-head">
        <img src="/photo.jpg" alt="" width="56" height="56" />
        <div>
          <h1>Amir Balazade</h1>
          <p>Front-end engineer. I build the screens where a wrong number is noticed in seconds.</p>
        </div>
      </header>
      <ul class="welcome-apps" aria-label="Projects">
        {
          projects.map((a) => (
            <li>
              <a class="welcome-app" href={a.href ?? `#${a.id}`} data-open={a.id}>
                <img src={iconSrc(a.icon, 96)} alt="" width="48" height="48" />
                <span>{a.desktop}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="welcome-foot">
        <a href="/cv" data-open="cv">Resume.doc</a>
        <a href="mailto:abalazade@gmail.com">abalazade@gmail.com</a>
        <a href="https://linkedin.com/in/amirbalazade" rel="me">LinkedIn</a>
      </p>
    </div>
  </Window>
</Desktop>
