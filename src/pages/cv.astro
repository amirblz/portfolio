---
import Base from "../layouts/Base.astro";
import cv from "../data/cv.json";

/** Escaped text, with the `**figure**` markers the CV source uses reaching the page as bold. */
const rich = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/[*][*](.+?)[*][*]/g, "<strong>$1</strong>");
---

<Base
  title="Amir Balazade | CV"
  description="Seven years of front-end engineering in fintech and web3: Angular, TypeScript, real-time trading views and payment flows."
  path="/cv"
>
  <h1 class="lede">{cv.name}</h1>
  <p class="standfirst" set:html={rich(cv.summary)} />

  <p>
    <a class="action" href="/amir-balazade-cv.pdf" download>Download as PDF</a>
  </p>

  <div class="prose">
    <h2>Experience</h2>
  </div>

  {
    cv.roles.map((role) => (
      <article class="cv-post">
        <div class="cv-head">
          <span class="cv-company">{role.company}</span>
          <span class="cv-dates">{role.dates}</span>
        </div>
        <p class="cv-title">
          {role.title}, {role.context}
          {role.arrangement ? `. ${role.arrangement}` : ""}
        </p>
        <ul>
          {role.bullets.map((line) => <li set:html={rich(line)} />)}
        </ul>
      </article>
    ))
  }

  <div class="prose">
    <h2>Projects</h2>
  </div>

  {
    cv.projects.map((project) => (
      <article class="cv-post">
        <div class="cv-head">
          <span class="cv-company">{project.name}</span>
          {project.dates && <span class="cv-dates">{project.dates}</span>}
        </div>
        <p class="cv-title">{project.description}</p>
        {project.bullets && (
          <ul>
            {project.bullets.map((line) => <li set:html={rich(line)} />)}
          </ul>
        )}
      </article>
    ))
  }

  <div class="prose">
    <h2>Skills</h2>
  </div>

  <dl class="cv-skills">
    {
      cv.skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(", ")}</dd>
        </div>
      ))
    }
  </dl>

  <div class="prose">
    <h2>Education</h2>
    <p>
      {cv.education.degree}, {cv.education.institution}, {cv.education.dates}
    </p>

    <h2>Languages</h2>
    <p>{cv.languages.join(", ")}</p>
  </div>
</Base>
