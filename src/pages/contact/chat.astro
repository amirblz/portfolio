---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import ym from "../../data/ym.json";
import emoticons from "../../data/ym-emoticons.json";
import { iconSrc } from "../../data/apps";

const amir = ym.groups[0].buddies[0];
// Sprite columns in /ym/toolbar.png, grey on top, colour on hover.
const ico = (x: number) => `--x: ${x}`;
---

<Desktop
  title="Chat with Amir | Amir Balazade"
  description="Leave Amir Balazade a message on Yahoo! Messenger. It reaches his inbox as an e-mail."
  path="/contact/chat"
>
  <Window app="chat" flush>
    <div class="ym-chat" data-ym-chat>
      <div class="xp-menubar">
        <div class="ym-menu">
          <button type="button" class="ym-menu-button" data-ym="menu" aria-haspopup="menu" aria-expanded="false" aria-controls="ym-menu"><u>C</u>onversation</button>
          <div class="ym-menu-list" id="ym-menu" role="menu" hidden>
            <button type="button" role="menuitem" data-ym="archive">Delete Archive...</button>
          </div>
        </div>
        {["Edit", "View", "Actions", "Help"].map((item) => <span aria-hidden="true"><u>{item[0]}</u>{item.slice(1)}</span>)}
      </div>
      <div class="ym-tools" role="toolbar" aria-label="Conversation tools">
        <button type="button" class="ym-tool" data-ym="email"><i class="ym-ico" style={ico(6)}></i>E-mail Amir</button>
        <a class="ym-tool" href="/contact" data-open="contact"><img class="ym-ico" src={iconSrc("ym")} alt="" width="26" height="26" />Buddies</a>
        <span class="xp-tool-sep" aria-hidden="true"></span>
        {
          ym.tools.map((t, i) => (
            <button type="button" class="ym-tool" data-ym-joke={t.joke}>
              <i class="ym-ico" style={ico(i)} />
              {t.label}
            </button>
          ))
        }
      </div>
      <p class="ym-to">
        <img src={`/ym/status/${amir.status}.png`} alt="" width="16" height="16" />
        <strong>{amir.name}</strong>
        <span class="sr-only">{` (${amir.status})`}</span>
        <span class="ym-to-note">{` - ${amir.note}`}</span>
      </p>
      <div class="ym-convo">
        <ol class="ym-log" aria-live="polite" aria-label="Message history">
          <li class="ym-note ym-nojs">The chat needs JavaScript. Write to <a href={`mailto:${ym.email}`}>{ym.email}</a> instead.</li>
        </ol>
        <figure class="ym-pic">
          <img src="/photo-168.webp" alt="" width="96" height="96" />
          <figcaption>{amir.name}</figcaption>
        </figure>
      </div>
      <div class="ym-format" role="toolbar" aria-label="Message">
        <button type="button" class="ym-fmt ym-fmt-smile" data-ym="smileys" aria-label="Emoticons" aria-expanded="false" aria-controls="ym-smileys">
          <i class="ym-ico" style={ico(0)}></i>
        </button>
        <button type="button" class="ym-fmt" data-ym-joke={ym.audibles} aria-label="Audibles"><i class="ym-ico" style={ico(1)}></i></button>
        <button type="button" class="ym-fmt ym-fmt-buzz" data-ym="buzz"><i class="ym-ico" style={ico(2)}></i>BUZZ!</button>
        <div class="ym-smileys" id="ym-smileys" role="group" aria-label="Emoticons" hidden>
          {
            Object.entries(emoticons).map(([id, codes]) => (
              <button type="button" data-ym-smiley={codes[0]} title={codes[0]} aria-label={codes[0]}>
                <img src={`/ym/emoticons/${id}.gif`} alt="" loading="lazy" />
              </button>
            ))
          }
        </div>
      </div>
      <p class="ym-as">Send As: <span data-ym-me>guest</span><span data-ym-reply></span></p>
      <div class="ym-compose">
        <textarea class="ym-input" aria-label="Message" rows="3" maxlength="1000"></textarea>
        <input class="ym-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="button" class="ym-send" data-ym="send">Send</button>
      </div>
      <p class="ym-tip" role="status" hidden></p>
      <div class="ym-confirm" hidden>
        <div class="window ym-confirm-box" role="alertdialog" aria-modal="true" aria-labelledby="ym-confirm-title" aria-describedby="ym-confirm-text">
          <div class="title-bar">
            <h3 class="title-bar-text" id="ym-confirm-title">Delete Archive</h3>
          </div>
          <div class="window-body">
            <p id="ym-confirm-text"><img src={iconSrc("question")} alt="" width="32" height="32" />Delete every message with {amir.name} saved on this device?</p>
            <div class="ym-confirm-buttons">
              <button type="button" data-ym="archive-yes">Yes</button>
              <button type="button" data-ym="archive-no">No</button>
            </div>
          </div>
        </div>
      </div>
      <div class="status-bar" aria-hidden="true">
        <p class="status-bar-field ym-typing" data-ym-typing></p>
        <p class="status-bar-field">Messages reach Amir by e-mail. History stays on this device.</p>
      </div>
    </div>
  </Window>
</Desktop>
