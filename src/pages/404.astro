---
// A blue screen, outside the desktop: nothing here should depend on the shell loading.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found | Amir Balazade</title>
    <meta name="description" content="That page doesn't exist on this site." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      html {
        background: #0000aa;
      }
      body {
        max-width: 72ch;
        margin: 0;
        padding: 32px 16px;
        color: #fff;
        font: 15px/1.45 "Lucida Console", "Courier New", monospace;
        cursor: default;
      }
      p {
        margin: 0 0 1.45em;
      }
      a {
        color: #fff;
      }
      a:focus-visible {
        outline: 1px dotted #fff;
        outline-offset: 2px;
      }
      .caret {
        animation: blink 1s steps(1) infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .caret {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1 hidden>Page not found</h1>
      <p>A problem has been detected and your portfolio has been shut down to prevent damage to your browser.</p>
      <p>PAGE_NOT_FOUND</p>
      <p>If this is the first time you've seen this Stop error screen, check the address for typos.</p>
      <p>
        If this screen appears again, go back to the <a href="/">desktop</a> and open a window from there. The
        CV is at <a href="/cv">/cv</a>.
      </p>
      <p>Technical information:</p>
      <p>*** STOP: 0x00000404 (0x00000000, 0xC0FFEE00, 0x00000000, 0x00000000)</p>
      <p><a href="/">Press any key to return to the desktop</a><span class="caret" aria-hidden="true">_</span></p>
    </main>
    <script is:inline>
      // Any key or click goes home, except on the links themselves and modifier presses.
      const home = (e) => {
        if (e.target.closest && e.target.closest("a")) return;
        if (e.key && (e.key === "Tab" || e.key === "Shift" || e.altKey || e.ctrlKey || e.metaKey)) return;
        location.assign("/");
      };
      addEventListener("keydown", home);
      addEventListener("click", home);
    </script>
  </body>
</html>
