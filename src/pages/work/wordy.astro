---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import Wizard from "../../components/Wizard.astro";
import WizardPage from "../../components/WizardPage.astro";
---

<Desktop
  title="wordy.cards: German vocabulary, offline"
  description="A German vocabulary PWA: 4,400+ words on a walk through seven places in Japan, scheduled by FSRS-5, fully offline on IndexedDB."
  path="/work/wordy"
>
  <Window app="wordy" flush>
    <Wizard icon="setup" finish={{ href: "/work/wordy/live", open: "wordy-live" }}>
      <WizardPage title="Welcome to the wordy.cards Setup Wizard" banner>
        <p>Learn German words on a walk through Japan.</p>
        <p>I designed and built wordy.cards: an Angular PWA on a NestJS and MongoDB API.</p>
        <p>To continue, click Next.</p>
      </WizardPage>
      <WizardPage title="Design" subtitle="Seven real places in Japan, one per level.">
        <p>A1 starts in spring mist in the Kiso Valley. The weather turns harsher with each level, up to Fuji in winter.</p>
        <div class="wiz-shots">
          <figure>
            <img src="/work/wordy/kiso-valley.webp" alt="Home screen at Kiso Valley, A1: ink mountains, pines and a walker on a path, with 0 of 843 words known" width="390" height="600" loading="lazy" />
            <figcaption>Kiso Valley, A1</figcaption>
          </figure>
          <figure>
            <img src="/work/wordy/tsurugi-dake.webp" alt="Home screen at Tsurugi-dake, B2-C1: a bare grey peak in driving sleet, with 0 of 1,205 words known" width="390" height="600" loading="lazy" />
            <figcaption>Tsurugi-dake, B2-C1</figcaption>
          </figure>
        </div>
      </WizardPage>
      <WizardPage title="Engine" subtitle="FSRS-5 spaced repetition over 4,400+ words.">
        <p>Flip the card, then swipe: Got it or Again. FSRS-5 picks the day the word comes back, and a slow pass returns once more in the same session.</p>
        <div class="wiz-shots">
          <figure>
            <img src="/work/wordy/card-front.webp" alt="Card front: NOUN, die Zeit, with the article and an edge stripe in the orange used for feminine nouns" width="390" height="515" loading="lazy" />
            <figcaption>Front, coloured by gender</figcaption>
          </figure>
          <figure>
            <img src="/work/wordy/card-back.webp" alt="Card back: die Zeit, plural Zeiten, meaning time, with an example sentence in German and English" width="390" height="515" loading="lazy" />
            <figcaption>Flipped</figcaption>
          </figure>
        </div>
      </WizardPage>
      <WizardPage title="Offline" subtitle="Works with no connection at all.">
        <p>Every word and review lives in IndexedDB on the phone. A level downloads again only when its content changes, and reviews sync to the server after each session.</p>
        <p>No account needed. An email sign-in backs up progress.</p>
      </WizardPage>
      <WizardPage title="Completing the wordy.cards Setup Wizard" banner>
        <p>wordy.cards is live. Click Finish to open it.</p>
        <fieldset class="wiz-req">
          <legend>System Requirements</legend>
          <ul>
            <li>Angular PWA, service worker</li>
            <li>NestJS and MongoDB API</li>
            <li>FSRS-5 scheduler (ts-fsrs)</li>
            <li>IndexedDB, content import in a Web Worker</li>
          </ul>
        </fieldset>
      </WizardPage>
    </Wizard>
  </Window>
</Desktop>
