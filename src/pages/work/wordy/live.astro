---
import Desktop from "../../../layouts/Desktop.astro";
import Window from "../../../components/Window.astro";
import Browser from "../../../components/Browser.astro";
---

<Desktop
  title="wordy.cards, live"
  description="wordy.cards running live: a German vocabulary PWA with FSRS-5 spaced repetition over 4,400+ words."
  path="/work/wordy/live"
>
  <Window app="wordy-live" flush>
    <Browser url="https://wordy.cards" label="wordy.cards, live">
      wordy.cards: 4,400+ German words. Flip, then swipe: Got it or Again. FSRS-5 picks the day it comes back.
    </Browser>
  </Window>
</Desktop>
