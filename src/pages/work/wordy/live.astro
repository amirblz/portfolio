---
import Desktop from "../../../layouts/Desktop.astro";
import Window from "../../../components/Window.astro";
import Browser from "../../../components/Browser.astro";
---

<Desktop
  title="wordy.cards, live"
  description="wordy.cards running live: a German vocabulary PWA with FSRS-5 spaced repetition over 3,500+ words."
  path="/work/wordy/live"
>
  <Window app="wordy-live" flush>
    <Browser url="https://wordy.cards" label="wordy.cards, live">
      wordy.cards: 3,500+ German words, scheduled by FSRS-5 and graded by how long you take to flip.
    </Browser>
  </Window>
</Desktop>
