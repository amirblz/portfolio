---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import Browser from "../../components/Browser.astro";
---

<Desktop
  title="Remorch: wallet, admin panel and payment page"
  description="Remorch's wallet PWA across 7 blockchains, its admin panel and its payment page: three Angular apps I built as front-end engineer."
  path="/work/remorch-app"
>
  <Window app="remorch-app" flush>
    <Browser url="https://remorch.com" label="remorch.com, live">
      Remorch: a wallet across 7 blockchains, an admin panel and an 80 kB payment page. I built all three.
    </Browser>
  </Window>
</Desktop>
