---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import Browser from "../../components/Browser.astro";
---

<Desktop
  title="OSSA: a small-batch storefront demo"
  description="A front-end demo of a limited clothing drop: stock per variant, a cart capped at real stock, and no fake checkout."
  path="/work/ossa"
>
  <Window app="ossa" flush>
    <Browser url="https://ossa.abalazade.workers.dev" label="OSSA demo store, live">
      OSSA: a clothing drop that sells out per size and colour. The cart never lets you buy more than exists.
    </Browser>
  </Window>
</Desktop>
