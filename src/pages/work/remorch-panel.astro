---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import PictureViewer from "../../components/PictureViewer.astro";

const shots = [
  {
    src: "/work/remorch-panel/pos-grid.webp",
    alt: "The payments grid on the POS tab, listing devices with accepted tokens and status, with creator names blurred",
    caption: "Payments grid, POS tab. Names blurred: production data.",
  },
  {
    src: "/work/remorch-panel/pos-order-detail.webp",
    alt: "A POS payment's detail page: original amount in AED, exchange rate, network, amount in USDC and fee, with the payer name blurred",
    caption: "One POS payment, from the original amount to the fee.",
  },
  {
    src: "/work/remorch-panel/login.webp",
    alt: "The panel's sign-in screen with email and password fields beside a Remorch brand card",
    caption: "Sign-in.",
  },
];
---

<Desktop
  title="Remorch admin panel"
  description="The panel Remorch's desk uses for orders, customers, partners and payouts: Angular 22, ag-grid and ECharts over live financial data."
  path="/work/remorch-panel"
>
  <Window app="remorch-panel" flush>
    <PictureViewer shots={shots}>
      <b>Remorch admin.</b> The desk runs orders, customers, partners and payouts from it, on Angular 22, ag-grid
      and ECharts.
    </PictureViewer>
  </Window>
</Desktop>
