---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import PictureViewer from "../../components/PictureViewer.astro";

const shots = [
  {
    src: "/work/remorch-pay/payment-link.webp",
    alt: "A payment link: a dark card showing 24.50 USDC on Polygon, beside pay and connect wallet buttons",
    caption: "A payment link, ready to pay. Mock data.",
  },
  {
    src: "/work/remorch-pay/payment-success.webp",
    alt: "The payment success screen with a receipt listing receiver, amount, network, rate and transaction hash",
    caption: "The receipt after a successful payment.",
  },
];
---

<Desktop
  title="Remorch payment page"
  description="The public page Remorch customers pay through: crypto payments on Polygon and BSC, built in Angular 22 with an 80 kB initial download."
  path="/work/remorch-pay"
>
  <Window app="remorch-pay" flush>
    <PictureViewer shots={shots}>
      <b>Remorch Pay.</b> The page customers pay through, in USDC on Polygon and BSC. Its first download is 80 kB.
    </PictureViewer>
  </Window>
</Desktop>
