---
import Desktop from "../../layouts/Desktop.astro";
import Window from "../../components/Window.astro";
import Browser from "../../components/Browser.astro";
---

<Desktop
  title="CAIRN: a scroll-driven product page demo"
  description="A demo store for a made-up flask brand: one scroll position drives a 3D product page, and the same page has a working bag."
  path="/work/cairn"
>
  <Window app="cairn" flush>
    <Browser url="https://cairn.abalazade.workers.dev" label="CAIRN demo store, live">
      CAIRN: one scroll position drives a 3D flask, and the same page has a working bag.
    </Browser>
  </Window>
</Desktop>
