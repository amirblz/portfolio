---
import Desktop from "../layouts/Desktop.astro";
import Window from "../components/Window.astro";
import MenuBar from "../components/MenuBar.astro";
import { iconSrc } from "../data/apps";

const email = "abalazade@gmail.com";
---

<Desktop
  title="Contact | Amir Balazade"
  description="Write to Amir Balazade at abalazade@gmail.com, or on LinkedIn."
  path="/contact"
>
  <Window app="contact" flush>
    <form class="oe" action={`mailto:${email}`} method="get" data-mailto={email}>
      <MenuBar items={["File", "Edit", "View", "Insert", "Format", "Tools", "Message", "Help"]} />
      <div class="xp-toolbar">
        <button type="submit" class="xp-tool tall"><img src={iconSrc("oe-send")} alt="" width="24" height="24" />Send</button>
        <span class="xp-tool-sep"></span>
        <a class="xp-tool tall" href="https://linkedin.com/in/amirbalazade" rel="me noopener" target="_blank">
          <img src={iconSrc("address-book")} alt="" width="24" height="24" />LinkedIn
        </a>
      </div>
      <div class="oe-fields">
        <span class="oe-label"><img src={iconSrc("email")} alt="" width="14" height="14" />To:</span>
        <p class="oe-field"><a href={`mailto:${email}`}>{email}</a></p>
        <label class="oe-label" for="oe-subject">Subject:</label>
        <input class="oe-field" id="oe-subject" name="subject" type="text" placeholder="Hello" />
      </div>
      <textarea class="oe-body" name="body" aria-label="Message"></textarea>
      <div class="status-bar" aria-hidden="true">
        <p class="status-bar-field">Send opens your mail app with this message.</p>
      </div>
    </form>
  </Window>
</Desktop>
