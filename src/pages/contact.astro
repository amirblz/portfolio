---
import Desktop from "../layouts/Desktop.astro";
import Window from "../components/Window.astro";
import MenuBar from "../components/MenuBar.astro";
import { apps, appById } from "../data/apps";
import ym from "../data/ym.json";

const external = (href: string) => href.startsWith("http");
// A buddy that is one of the desktop's own windows opens as a window, not a page load.
const appOf = (href: string) => apps.find((a) => a.href === href)?.id;
---

<Desktop
  title="Contact | Amir Balazade"
  description="Chat with Amir Balazade on Yahoo! Messenger, or write by e-mail to contact@amirbalazade.com or on LinkedIn."
  path="/contact"
>
  <Window app="contact" flush>
    <div class="ym-buddies">
      <MenuBar items={["Messenger", "View", "Contacts", "Actions", "Help"]} />
      <p class="ym-me">
        <img src="/ym/status/online.png" alt="" width="16" height="16" />
        <strong data-ym-me>guest</strong>
        <span class="ym-me-status">{" - "}Available</span>
      </p>
      <div class="ym-list">
        {
          ym.groups.map((g) => (
            <details class="ym-group" open>
              <summary>{g.name}</summary>
              <ul>
                {g.buddies.map((b) => (
                  <li>
                    <a
                      class="ym-buddy"
                      href={b.href}
                      data-open={appOf(b.href)}
                      {...(external(b.href) && { target: "_blank", rel: "me noopener" })}
                    >
                      <img src={`/ym/status/${b.status}.png`} alt="" width="16" height="16" />
                      <span class="ym-buddy-name">{b.name}</span>
                      <span class="sr-only">{` (${b.status})`}</span>
                      <span class="ym-buddy-note">{` - ${b.note}`}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
      <div class="ym-ad" data-ym-ads>
        {
          ym.ads.map((ad, i) => (
            <a href={appById[ad.app].href} data-open={ad.app} hidden={i > 0} aria-label={`${ad.title}: ${ad.text}`}>
              <strong>{ad.title}</strong>
              <span>{ad.text}</span>
              <em>Try it now &raquo;</em>
            </a>
          ))
        }
      </div>
    </div>
  </Window>
</Desktop>
